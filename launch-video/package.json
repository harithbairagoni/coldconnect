{
  "name": "coldconnect-launch-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion launch video for ColdConnect. VO + BGM synthesized with ElevenLabs.",
  "scripts": {
    "synth": "node scripts/elevenlabs.mjs synth",
    "voices": "node scripts/elevenlabs.mjs voices",
    "measure": "node scripts/measure.mjs",
    "render": "remotion render src/index.ts LaunchVideo out/launch.mp4",
    "render:720": "remotion render src/index.ts LaunchVideo out/launch-720p.mp4 --scale=0.666666",
    "poster": "remotion still src/index.ts LaunchVideo out/poster.png --frame=560 --scale=0.5"
  },
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "@remotion/google-fonts": "4.0.520",
    "@remotion/media": "4.0.520",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.8.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.0"
  }
}
